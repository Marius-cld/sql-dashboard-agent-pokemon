# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env est ignoré par git : ne jamais y committer de secret.
#
# L'API (src/agent_api.py) charge ce fichier au démarrage. Une variable déjà
# exportée dans le shell l'emporte sur la valeur écrite ici.

# --- Anthropic ---------------------------------------------------------------
# Clé API utilisée par l'agent de génération de tableaux de bord (src/agent_api.py).
# À créer sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
